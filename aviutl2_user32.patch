diff --git a/dlls/user32/defdlg.c b/dlls/user32/defdlg.c
index 87b3c37fe09..ec61543bee3 100644
--- a/dlls/user32/defdlg.c
+++ b/dlls/user32/defdlg.c
@@ -208,9 +208,20 @@ static HWND root_dialog(HWND hwnd)
 static LRESULT DEFDLG_Proc( HWND hwnd, UINT msg, WPARAM wParam,
                             LPARAM lParam, DIALOGINFO *dlgInfo )
 {
-    switch(msg)
-    {
-        case WM_ERASEBKGND:
+switch(msg)
+            {
+            case WM_KEYDOWN:
+                if (wParam == VK_SPACE)
+                {
+                    HWND hwndFocus = GetFocus();
+                    if (hwndFocus && IsChild( hwnd, hwndFocus ))
+                        SendMessageW( hwnd, WM_COMMAND,
+                                MAKEWPARAM( GetDlgCtrlID( hwndFocus ), BN_CLICKED ),
+                                (LPARAM)hwndFocus );
+                    return 0;
+                }
+                return DefWindowProcW( hwnd, msg, wParam, lParam );
+            case WM_ERASEBKGND:
         {
             HBRUSH brush = (HBRUSH)SendMessageW( hwnd, WM_CTLCOLORDLG, wParam, (LPARAM)hwnd );
             if (!brush) brush = (HBRUSH)DefWindowProcW( hwnd, WM_CTLCOLORDLG, wParam, (LPARAM)hwnd );
